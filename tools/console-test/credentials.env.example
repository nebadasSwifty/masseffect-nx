# Copy this file to credentials.env (same folder) and edit it. credentials.env is ignored by git; never commit it.
# Lines are KEY=VALUE, no quotes, no spaces around "=". Variables set in your shell win over this file.

# Address of the console on your network (Settings > Internet on the Switch shows it).
SWITCH_IP=192.168.0.50

# sys-ftpd on the console. The defaults of its stock configuration are an open server on port 5000.
FTP_PORT=5000
#FTP_USER=anonymous
#FTP_PASS=

# sys-botbase (only for the unattended cycle): port 6000 unless you changed it.
#BOT_PORT=6000

# Folder of the NRO on the SD card.
#SD_DIR=/switch/masseffect-nx

# The game streams its log to this computer over TCP (cvar log_network). The address is detected; set it if the
# detection picks the wrong network interface.
#LIVE_LOG_HOST=192.168.0.10
#LIVE_LOG_PORT=28771

# Reference screenshots for switch_bot.py (see its --help); default tools/console-test/ref.
#REF_DIR=/path/to/ref
