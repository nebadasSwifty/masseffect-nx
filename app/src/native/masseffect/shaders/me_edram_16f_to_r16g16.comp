#version 450

// Typeless EDRAM reinterpretation: host RGBA16F image (Xenos k_2_10_10_10_FLOAT / 7e3, EDRAM class 3, or UNORM10, class 2)
// -> host R16G16_UNORM image (Xenos k_16_16, EDRAM class 4).
// Packs RGBA16F into raw 32-bit word and writes to R16G16_UNORM (via r32ui view).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D source;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D target;
layout(push_constant) uniform Constants {
  uvec2 source_size;
  uvec2 target_size;
  uint pitch_tiles_source;
  uint pitch_tiles_target;
  uint tile_source_start;
  uint tile_target_start;
  uint tiles_count;
  uint source_format;
  uint target_format;
  uint source_64bpp;
  uint target_64bpp;
  uint source_msaa_x, source_msaa_y;
  uint target_msaa_x, target_msaa_y;
} c;

// Tile index / pitch without an integer division (a long instruction sequence on Maxwell): tile and pitch are at most
// 2048, so the fraction of (tile + 0.5) / pitch is at least 0.5 / 2048 away from an integer and the float quotient
// floors to the exact integer one.
uint DivPitch(uint tile, uint pitch) { return uint((float(tile) + 0.5) / float(pitch)); }
uint ModPitch(uint tile, uint pitch) { return tile - DivPitch(tile, pitch) * pitch; }

uint Pack32(vec4 v) {
  uvec2 u16 = uvec2(round(clamp(v.rg, 0.0, 1.0) * 65535.0));
  return u16.r | (u16.g << 16u);
}

void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  if ((q.x & ((1u << c.target_msaa_x) - 1u)) != 0u ||
      (q.y & ((1u << c.target_msaa_y) - 1u)) != 0u) return;
  bool range = c.tiles_count != 0u;
  if (range && (q.y >= 16u || q.x >= c.tiles_count * 80u)) return;
  uint relative    = q.x / 80u;
  uint word_local  = q.x % 80u;
  uint tile_target = range ? c.tile_target_start + relative
                           : (q.y / 16u) * c.pitch_tiles_target + relative;
  uint tile_source = range ? c.tile_source_start + relative : tile_target;

  uvec2 ps = uvec2(ModPitch(tile_source, c.pitch_tiles_source) * (80u >> c.source_64bpp) + (word_local >> c.source_64bpp),
                   DivPitch(tile_source, c.pitch_tiles_source) * 16u + q.y % 16u)
             >> uvec2(c.source_msaa_x, c.source_msaa_y);
  if (any(greaterThanEqual(ps, c.source_size))) return;

  vec4 v = imageLoad(source, ivec2(ps));
  uint word = Pack32(v);

  uvec2 pt = uvec2(ModPitch(tile_target, c.pitch_tiles_target) * 80u + word_local,
                   DivPitch(tile_target, c.pitch_tiles_target) * 16u + q.y % 16u)
             >> uvec2(c.target_msaa_x, c.target_msaa_y);
  if (any(greaterThanEqual(pt, c.target_size))) return;

  imageStore(target, ivec2(pt), uvec4(word, 0u, 0u, 0u));
}
