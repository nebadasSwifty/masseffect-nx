#version 450

// Raw 8:8:8:8 EDRAM words reinterpreted as a packed 32-bit render target or
// as a true 64-bit FP16 target.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform Constants {
  uvec2 source_size;
  uvec2 target_size;
  uint pitch_tiles_source;
  uint pitch_tiles_target;
  uint tile_source_start;
  uint tile_target_start;
  uint tiles_count;
  uint source_format;
  uint target_format;
  uint source_64bpp;
  uint target_64bpp;
  uint source_msaa_x, source_msaa_y;
  uint target_msaa_x, target_msaa_y;
} c;

// EDRAM address math without IMUL (docs/edram-shader-imul.md; exactness: tests/cpu/test_native_edram_imul_free.cpp).
// NAK on SM50 emits the microcoded, variable-latency IMUL for every 32-bit multiply that is not by a power of two,
// IMUL.HI for a division by a constant and a long IMUL sequence for a division by a register. Integers below 2^24
// are exact in float, so these use FMUL/FFMA and conversions instead:
// - DivPitch: tile < 2^16, 1 <= pitch <= 2048; the fraction of (tile + 0.5) / pitch is at least 0.5 / pitch away
//   from an integer, far more than the error of the reciprocal, so the float quotient floors to the integer one;
// - MulSmall: a * b < 2^24 (row * pitch, quotient * pitch);
// - Div80 / Mod80: x < 2^20; Mul80 is two shifts and an add.
uint DivPitch(uint tile, uint pitch) { return uint((float(tile) + 0.5) / float(pitch)); }
uint MulSmall(uint a, uint b) { return uint(float(a) * float(b)); }
uint ModPitch(uint tile, uint pitch) { return tile - MulSmall(DivPitch(tile, pitch), pitch); }
uint Div80(uint x) { return uint(fma(float(x), 0.0125, 0.00625)); }
uint Mul80(uint x) { return (x << 6u) + (x << 4u); }
uint Mod80(uint x) { return x - Mul80(Div80(x)); }

float From7e3(uint f10) {
  f10 &= 0x3FFu;
  if (f10 == 0u) return 0.0;
  uint mantissa = f10 & 0x7Fu;
  uint exponent = f10 >> 7u;
  if (exponent == 0u) {
    uint displacement = 7u - uint(findMSB(mantissa));
    exponent = 1u - displacement;
    mantissa = (mantissa << displacement) & 0x7Fu;
  }
  return uintBitsToFloat(((exponent + 124u) << 23u) | (mantissa << 16u));
}

vec4 Unpack32(uint word) {
  if (c.target_format == 2u) {
    return vec4(float(word & 0x3FFu), float((word >> 10u) & 0x3FFu),
                float((word >> 20u) & 0x3FFu), float(word >> 30u)) /
           vec4(1023.0, 1023.0, 1023.0, 3.0);
  }
  return vec4(From7e3(word), From7e3(word >> 10u), From7e3(word >> 20u),
              float(word >> 30u) * (1.0 / 3.0));
}

uint ReadWord(uint tile, uint word_local) {
  uvec2 p = uvec2(Mul80(ModPitch(tile, c.pitch_tiles_source)) + word_local,
                  DivPitch(tile, c.pitch_tiles_source) * 16u + gl_GlobalInvocationID.y % 16u) >> uvec2(c.source_msaa_x, c.source_msaa_y);
  if (any(greaterThanEqual(p, c.source_size))) return 0u;
  uvec4 bytes = uvec4(round(imageLoad(source, ivec2(p)) * 255.0));
  return bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (bytes.a << 24u);
}

void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  // Single writer per collapsed host texel. Physical samples are replicated on read.
  if ((q.x & ((1u << (c.target_64bpp + c.target_msaa_x)) - 1u)) != 0u ||
      (q.y & ((1u << c.target_msaa_y) - 1u)) != 0u) return;
  bool range = c.tiles_count != 0u;
  if (range && (q.y >= 16u || q.x >= Mul80(c.tiles_count))) return;
  uint relative = Div80(q.x);
  uint word_local = Mod80(q.x);
  uint tile_target = range ? c.tile_target_start + relative
                            : MulSmall(q.y >> 4u, c.pitch_tiles_target) + relative;
  uint tile_source = range ? c.tile_source_start + relative : tile_target;
  uvec2 p = uvec2((Mul80(ModPitch(tile_target, c.pitch_tiles_target)) >> c.target_64bpp) +
                      (word_local >> c.target_64bpp),
                  DivPitch(tile_target, c.pitch_tiles_target) * 16u + q.y % 16u) >> uvec2(c.target_msaa_x, c.target_msaa_y);
  if (any(greaterThanEqual(p, c.target_size))) return;
  if (c.target_64bpp != 0u) {
    if ((word_local & 1u) != 0u) return;
    imageStore(target, ivec2(p),
               vec4(unpackHalf2x16(ReadWord(tile_source, word_local)),
                    unpackHalf2x16(ReadWord(tile_source, word_local + 1u))));
  } else {
    imageStore(target, ivec2(p), Unpack32(ReadWord(tile_source, word_local)));
  }
}
